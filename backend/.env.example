# Copy to .env and adjust as needed.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
DB_PATH=./otonomy.db

# --- Google Calendar two-way sync (optional) ---
# Leave blank to disable; the app shows a "not configured" state and everyone
# can still use the ICS subscription feed. To enable:
#   1. Create a project at https://console.cloud.google.com/
#   2. APIs & Services → Enable "Google Calendar API"
#   3. Credentials → Create OAuth client ID → type "Web application"
#   4. Add an Authorized redirect URI equal to GOOGLE_REDIRECT_URI below
#   5. OAuth consent screen → add the scope .../auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Timezone the naive shift times are interpreted in when pushed to Google.
SCHEDULE_TIMEZONE=America/New_York
